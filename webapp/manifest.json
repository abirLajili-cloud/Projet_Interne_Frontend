{
  "_version": "1.73.1",
  "sap.app": {
    "id": "printerne",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.5",
      "toolsId": "fec55ed2-4f95-4355-8e4e-4952f5623388"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_purreq/srvd/sap/zsd_purreq/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "authService": {
        "uri": "/sap/opu/odata4/sap/zsb_bp/srvd/sap/zsd_businesspartner/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/authService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.9",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "printerne.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "authModel": {
        "dataSource": "authService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "odataVersion": "4.0"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "viewPath": "printerne.view",
        "async": true
      },
      "routes": [
        {
          "name": "Auth",
          "pattern": "",
          "target": [
            "Auth"
          ]
        },
        {
          "name": "PRView",
          "pattern": "client",
          "target": [
            "PRView"
          ]
        },
        {
          "name": "FournisseurView",
          "pattern": "fournisseur",
          "target": [
            "FournisseurView"
          ]
        },
        {
          "name": "AdministratorView",
          "pattern": "Administrator",
          "target": [
            "AdministratorView"
          ]
        }
      ],
      "targets": {
        "Auth": {
          "viewName": "Auth",
          "viewLevel": 1,
          "id": "Auth"
        },
        "PRView": {
          "viewName": "PR_View",
          "viewLevel": 2,
          "id": "PR_View"
        },
        "FournisseurView": {
          "viewName": "Fournisseur",
          "viewLevel": 2,
          "id": "Fournisseur"
        },
        "AdministratorView": {
          "viewName": "Administrator",
          "viewLevel": 2,
          "id": "Administrator"
        }
      }
    },
    "rootView": {
      "viewName": "printerne.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
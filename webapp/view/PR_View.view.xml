<mvc:View controllerName="printerne.controller.PR_View"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="page" class="sapUiContentPadding">
        <content>
            <!-- Toolbar principale -->
            <Toolbar class="sapUiMediumMarginBottom">
                <SearchField width="50%" placeholder="Search requisitions..." liveChange="onSearchHeader"/>
                <ToolbarSpacer/>
                <Button text="Create Requisition" type="Emphasized" press="onCreateHeader" icon="sap-icon://add"/>
            </Toolbar>

            <!-- Barre avec deux boutons -->
            <HBox class="sapUiSmallMarginBottom" justifyContent="Start" alignItems="Center">
                <Button text="Purchase Requisition List" width="220px" type="Default" icon="sap-icon://list" press="onShowRequisitionList" class="actionButton"/>
                <Button text="Purchase Order List" width="220px" type="Default" icon="sap-icon://order-status" press="onShowOrderList" class="actionButton"/>
            </HBox>

            <!-- Table des réquisitions -->
            <Table id="headerTable" items="{/PurchaseReqHeader}" growing="true" growingScrollToLoad="true" inset="false" class="customTable">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Requisitions List" level="H2" class="blueTitle"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Purchase Requisition" class="blueTitle"/></Column>
                    <Column><Text text="Document Type" class="blueTitle"/></Column>
                    <Column><Text text="Total Value" class="blueTitle"/></Column>
                    <Column><Text text="Number of Items" class="blueTitle"/></Column>
                    <Column><Text text="Status" class="blueTitle"/></Column>
                    <Column><Text text="Actions" class="blueTitle"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{PurchaseRequisition}"/>
                            <Text text="{PurchaseRequisitionType}"/>
                            <Text text="0.00 EUR"/>
                            <Text text="1"/>
                            <Text text="Approved" class="statusApproved"/>
                            <Button text="Create Order" type="Emphasized" press="onCreateOrder" icon="sap-icon://cart"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>

    <!-- Dialog pour création Réquisition -->
    <Dialog id="createDialogHeader" title="Add Purchase Requisition" class="sapUiContentPadding" stretch="true">
        <VBox class="sapUiSmallMargin">
            <Title text="General Information" level="H2" class="blueTitle sapUiMediumMarginBottom"/>
            <HBox class="sapUiSmallMarginBottom" justifyContent="SpaceBetween">
                <VBox>
                    <Label text="Purchase Requisition Description:" class="labelHighlight"/>
                    <Input id="descriptionInput" placeholder="Enter description" width="300px" class="inputHighlight"/>
                </VBox>
                <VBox>
                    <Label text="Document Type *" class="labelHighlight"/>
                    <Select id="documentTypeSelect" width="300px" class="inputHighlight">
                        <items>
                            <core:Item key="NB" text="Pur. Requisition (NB)"/>
                            <core:Item key="NBS" text="Pur. Requisition NBS (NBS)"/>
                            <core:Item key="RV" text="Outline Agrmt. Reqn. (RV)"/>
                        </items>
                    </Select>
                </VBox>
                <VBox>
                    <Label text="Automatic Source Determination:" class="labelHighlight"/>
                    <CheckBox id="autoSourceCheck"/>
                </VBox>
            </HBox>

            <Title text="Notes" level="H2" class="blueTitle sapUiMediumMarginBottom"/>
            <Label text="Header Note" class="blueTitle"/>
            <TextArea id="headerNoteInput" rows="3" placeholder="Enter header note" width="100%"/>

            <ObjectHeader title="Items" class="blueTitle"/>
            <Toolbar class="sapUiMediumMarginBottom">
                <ToolbarSpacer/>
                <MenuButton text="Create" icon="sap-icon://add" type="Emphasized">
                    <menu>
                        <Menu>
                            <MenuItem text="Material" press="onAddMaterial"/>
                            <MenuItem text="Service" press="onAddService"/>
                            <MenuItem text="Items from Cross-Catalog Search" press="onAddCrossCatalog"/>
                            <MenuItem text="Items from External Catalogs" press="onAddExternal"/>
                        </Menu>
                    </menu>
                </MenuButton>
            </Toolbar>

            <Table id="itemsTable" items="{local>/NewItems}" class="customTable">
                <columns>
                    <Column><Text text="Item"/></Column>
                    <Column><Text text="Product Type Group"/></Column>
                    <Column><Text text="Material"/></Column>
                    <Column><Text text="Material Group"/></Column>
                    <Column><Text text="Plant"/></Column>
                    <Column><Text text="Quantity"/></Column>
                    <Column><Text text="Valuation Price"/></Column>
                    <Column><Text text="Requisitioner"/></Column>
                    <Column><Text text="Total Value"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{Item}"/>
                            <Text text="{ProductTypeGroup}"/>
                            <Input value="{Material}" placeholder="Material" class="inputHighlight"/>
                            <Input value="{MaterialGroup}" placeholder="Material Group" class="inputHighlight"/>
                            <Input value="{Plant}" placeholder="Plant" class="inputHighlight"/>
                            <Input value="{Quantity}" placeholder="Quantity" class="inputHighlight"/>
                            <Input value="{ValuationPrice}" placeholder="Valuation Price" class="inputHighlight"/>
                            <Input value="{Requisitioner}" placeholder="Requisitioner" class="inputHighlight"/>
                            <Input value="{TotalValue}" placeholder="Total Value" class="inputHighlight"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveHeader"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" type="Reject" press="onCancelHeader"/>
        </endButton>
    </Dialog>

    <Dialog id="confirmOrderDialog" title="Confirm Order Creation" class="sapUiContentPadding">
        <VBox class="sapUiSmallMargin">
            <Text text="Do you want to create an order for this requisition?" class="blueTitle"/>
        </VBox>
        <beginButton>
            <Button text="Confirm" type="Emphasized" press="onConfirmOrder"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" type="Reject" press="onCancelOrder"/>
        </endButton>
    </Dialog>
</mvc:View>
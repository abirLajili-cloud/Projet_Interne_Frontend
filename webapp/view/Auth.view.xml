<mvc:View controllerName="printerne.controller.Auth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="authPage" class="sapUiContentPadding">
        <content>
            <VBox class="auth-container" justifyContent="Center" alignItems="Center">
                <Input id="userIdInput" placeholder="User ID" width="250px"/>
                <Input id="passwordInput" placeholder="Password" type="Password" width="250px"/>
                <Button text="Login" type="Emphasized" press="onLoginPress"/>
            </VBox>
         </content>
    </Page>
</mvc:View>